# Build output
bin/
obj/
dist/
build/

# Per-machine tool paths for the scripts (see .env.template)
.env

# Per-machine build overrides (game path, BepInEx profile path)
Config.Build.user.props

# Loader packs / tool binaries are downloaded, never committed
vendor/*.zip
tools/
*.exe

# libmpv for Windows, bundled into packages but never committed (~60-80 MB):
# drop mpv-2.dll here once, then scripts\package.ps1 picks it up. See README.
deps/

# Decompiled game output (copyrighted, regenerable with Cpp2IL, enormous)
gamesrc/
cpp2il_out/
*.dump

# IDE / OS
.vs/
.idea/
*.user
*.suo
Thumbs.db
.DS_Store
